# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma7.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL="postgresql://user:password@localhost:5433/fleet_db?schema=public"

# JWT
JWT_SECRET="sua_chave_aleatoria"
JWT_EXPIRATION="24h"

# Application
PORT=3000
NODE_ENV=development


# Google Cloud Storage (armazena as fotos de incidentes)
# GCS_KEY_FILE: caminho do arquivo JSON da Service Account (baixado no console
# do GCP). Nunca commitar esse arquivo — mantenha-o fora do controle de versão.
GCS_BUCKET_NAME="velocityfleet-imagens"
GCS_PROJECT_ID="micro-avenue-510016-r5"
GCS_KEY_FILE="./micro-avenue-510016-r5-c1918baaad3f.json"


# External APIs
CEP_API_URL="https://api.com.br/ws"
CEP_TIMEOUT_MS=10000

# CORS: "*" libera qualquer origem (uso em dev). Em produção, use uma lista de
# domínios do frontend separados por vírgula, ex: "https://app.com,https://admin.app.com"
CORS_ORIGIN="*"

#Admin inicial
ADMIN_EMAIL="example@example.com"
ADMIN_INITIAL_PASSWORD="example@123"

# Chave de API fixa da aplicacao: a MESMA chave vale para todos os usuarios
# (ADMIN, FLEET_MANAGER, DRIVER); ela nao identifica ninguem, so libera o
# acesso ao POST /auth/login. 64 caracteres hex minusculos (openssl rand -hex 32)
API_KEY=""
